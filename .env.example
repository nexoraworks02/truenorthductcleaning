# TrueNorth Duct Cleaning — environment variables
# Copy to .env.local for local dev, and add the same keys in Vercel:
#   Vercel → Project → Settings → Environment Variables.
# All of these are OPTIONAL — the site runs fine with them empty. Set each one
# when you have the real value. Never commit real .env files (only this example).

# Google Analytics 4 measurement id, e.g. G-XXXXXXXXXX
# analytics.google.com → Admin → Data streams
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Meta (Facebook/Instagram) Pixel id, e.g. 1234567890
# Meta Events Manager → Data sources → your pixel
NEXT_PUBLIC_META_PIXEL_ID=

# Google Search Console HTML-tag verification value (the content="..." string)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Web3Forms access key for the booking form. A working key is already baked into
# the code; set this only to override it (must be registered to the inbox that
# should receive bookings — truenorthductcleaning318@gmail.com).
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
